{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SENSO 실행 (컨테이너: 웹 8550 / PC: 창)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/main.py",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "pytest 전체",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
