# SENSO 운영(배포)용 이미지. 개발용 Dockerfile과 다른 점:
#   - 의존성은 requirements.lock (버전 + 해시 고정)으로만 설치한다
#   - git, pytest, ruff 같은 개발 도구가 없다
#   - 소스 폴더를 연결하지 않고 src/ 만 이미지에 넣는다
#   - root가 아닌 senso 사용자(uid 10001)로 실행한다
# 실행: docker compose -f compose.prod.yaml up -d --build   (PRODUCTION.md 참고)

# 베이스 이미지도 다이제스트로 고정한다 (갱신 방법은 PRODUCTION.md)
FROM python:3.15-slim@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app/src \
    SENSO_DATA_DIR=/data \
    SENSO_TZ=Asia/Seoul \
    FLET_FORCE_WEB_SERVER=true \
    FLET_SERVER_IP=0.0.0.0 \
    FLET_SERVER_PORT=8550 \
    HOME=/tmp

# 화면에 보여 줄 빌드 표시 (비워 두면 앱이 소스 코드 지문을 대신 보여 준다)
ARG SENSO_BUILD=""
ENV SENSO_BUILD=${SENSO_BUILD}

WORKDIR /app

COPY requirements.lock .
RUN pip install --require-hashes --no-deps -r requirements.lock

# 실행 전용 사용자. 코드는 root 소유(읽기만 가능), 데이터 폴더만 senso 소유
RUN groupadd --system --gid 10001 senso \
    && useradd --system --uid 10001 --gid senso --no-create-home --shell /usr/sbin/nologin senso \
    && mkdir -p /data \
    && chown senso:senso /data \
    && chmod 700 /data

COPY --chown=root:root src/ /app/src/
RUN find /app/src -type d -name __pycache__ -prune -exec rm -rf {} + \
    && find /app/src -type d -exec chmod 555 {} + \
    && find /app/src -type f -exec chmod 444 {} +

USER senso
EXPOSE 8550

# 앱이 응답하는지 30초마다 확인 (curl 없이 파이썬으로)
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8550/', timeout=4)"]

CMD ["python", "src/main.py"]
